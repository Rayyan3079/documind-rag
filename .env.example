# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-api-key-here

# Model used to answer questions. claude-haiku-5-5 is much cheaper for experiments.
DOCUMIND_MODEL=claude-opus-5-5
# Model used as LLM-as-judge in the evaluation (defaults to DOCUMIND_MODEL).
# DOCUMIND_JUDGE_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
DOCUMIND_EFFORT=medium

# Retrieval / ingestion (defaults shown)
# DOCUMIND_DOCS_DIR=data/docs
# DOCUMIND_INDEX_DIR=data/index
# DOCUMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# DOCUMIND_CHUNK_SIZE=800
# DOCUMIND_CHUNK_OVERLAP=150
# DOCUMIND_TOP_K=5
# DOCUMIND_RETRIEVAL_MODE=hybrid
